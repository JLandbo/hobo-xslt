<Window x:Class="HoboXslt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="hobo-xslt" Height="800" Width="1400"
        Loaded="Window_Loaded" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="avalonEdit:TextEditor">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ShowLineNumbers" Value="True" />
        </Style>
        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="PaneButton" TargetType="Button">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="100" />
            <RowDefinition Height="6" />
            <RowDefinition Height="180" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ToolBar>
                <Button x:Name="RunButton" Content="Kør" IsEnabled="False" Click="Run_Click" />
                <Button x:Name="DebugButton" Content="Debug" ToolTip="Start debugging (F5)" IsEnabled="False" Click="Debug_Click" />
                <Separator />
                <Button x:Name="ContinueButton" Content="Fortsæt" ToolTip="Fortsæt (F5)" IsEnabled="False" Click="Continue_Click" />
                <Button x:Name="StepIntoButton" Content="Step into" ToolTip="Step into (F11)" IsEnabled="False" Click="StepInto_Click" />
                <Button x:Name="StepOverButton" Content="Step over" ToolTip="Step over (F10)" IsEnabled="False" Click="StepOver_Click" />
                <Button x:Name="StepOutButton" Content="Step out" ToolTip="Step out (Shift+F11)" IsEnabled="False" Click="StepOut_Click" />
                <Button x:Name="StopButton" Content="Stop" ToolTip="Stop (Shift+F5)" IsEnabled="False" Click="Stop_Click" />
            </ToolBar>

            <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="XPath" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2" Style="{StaticResource PaneTitle}" />
                <TextBox x:Name="XPathBox" Grid.Column="1" VerticalAlignment="Top" FontFamily="Consolas" KeyDown="XPathBox_KeyDown" />
                <Button x:Name="XPathButton" Grid.Column="2" VerticalAlignment="Top" Content="Evaluér" IsEnabled="False" Style="{StaticResource PaneButton}" Click="EvaluateXPath_Click" />
                <TextBox x:Name="XPathResultBox" Grid.Column="3" Margin="8,0,0,0" MaxHeight="120" IsReadOnly="True" FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.3*" MinWidth="150" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="6,4">
                    <Button DockPanel.Dock="Right" Content="Gem" Style="{StaticResource PaneButton}" Click="SaveXml_Click" />
                    <Button DockPanel.Dock="Right" Content="Åbn…" Style="{StaticResource PaneButton}" Click="OpenXml_Click" />
                    <TextBlock x:Name="XmlTitle" Style="{StaticResource PaneTitle}" />
                </DockPanel>
                <avalonEdit:TextEditor x:Name="XmlEditor" SyntaxHighlighting="XML" />
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="6,4">
                    <Button DockPanel.Dock="Right" Content="Gem" Style="{StaticResource PaneButton}" Click="SaveXslt_Click" />
                    <Button DockPanel.Dock="Right" Content="Åbn…" Style="{StaticResource PaneButton}" Click="OpenXslt_Click" />
                    <TextBlock Text="XSLT" Style="{StaticResource PaneTitle}" />
                </DockPanel>
                <TabControl x:Name="XsltTabs">
                    <TabItem x:Name="XsltMainTab">
                        <TabItem.Header>
                            <TextBlock x:Name="XsltTitle" />
                        </TabItem.Header>
                        <avalonEdit:TextEditor x:Name="XsltEditor" SyntaxHighlighting="XML" />
                    </TabItem>
                </TabControl>
            </DockPanel>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Margin="6,4" Padding="0,2" Text="Output" Style="{StaticResource PaneTitle}" />
                <avalonEdit:TextEditor x:Name="OutputEditor" IsReadOnly="True" />
            </DockPanel>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

        <TabControl Grid.Row="3">
            <TabItem x:Name="DiagnosticsTab" Header="Fejl og beskeder">
                <ListView x:Name="DiagnosticsList">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="Diagnostic_DoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Placering" Width="160" DisplayMemberBinding="{Binding Location}" />
                            <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Header="Besked" Width="900" DisplayMemberBinding="{Binding Text}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem x:Name="VariablesTab" Header="Variabler">
                <ListView x:Name="VariablesList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Navn" Width="200" DisplayMemberBinding="{Binding Name, StringFormat='${0}'}" />
                            <GridViewColumn Header="Værdi" Width="900" DisplayMemberBinding="{Binding Value, TargetNullValue=utilgængelig}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="4">
            <TextBlock x:Name="StatusText" Text="Starter Saxon…" />
        </StatusBar>
    </Grid>
</Window>
